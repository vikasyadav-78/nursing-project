# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MySQL Connection String)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=mysql://root:password@localhost:3306/nursing_db

# Security & JWT Token
JWT_SECRET=your_production_secret_jwt_key_min_32_chars

# Cache (Redis - Optional, falls back to In-Memory cache if not running)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
