generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  username          String   @unique
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  email             String   @unique
  password          String
  role              String   @default("admin")
  mobile            String?
  location          String?
  educationLevel    String?  @map("education_level")
  coursePreferences Json?    @map("course_preferences")
  examPreferences   Json?    @map("exam_preferences")
  budget            String?
  careerInterests   Json?    @map("career_interests")
  isActive          Boolean? @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([role])
  @@map("users")
}

model College {
  id                 String   @id @default(uuid())
  name               String
  code               String   @unique
  description        String?  @db.Text
  sector             String?  @default("Private")
  genderAcceptance   String?  @default("Co-ed") @map("gender_acceptance")
  establishedYear    Int?     @map("established_year")
  state              String?
  district           String?
  city               String?
  address            String?  @db.Text
  googleMapLink      String?  @db.Text @map("google_map_link")
  affiliation        String?  @db.Text
  approvedBy         String?  @db.Text @map("approved_by")
  coursesCount       Int?     @map("courses_count")
  experienceYears    Int?     @map("experience_years")
  studentsCount      Int?     @map("students_count")
  facilities         Json?
  gallery            Json?
  thumbnail          String?
  youtubeVideo       String?  @db.Text @map("youtube_video")
  courseIds          Json?    @map("course_ids")
  stream             String?
  rating             String?
  nirfRank           String?  @map("nirf_rank")
  minFee             Int?     @map("min_fee")
  maxFee             Int?     @map("max_fee")
  tuitionFeesDisplay String?  @map("tuition_fees_display")
  examsAccepted      Json?    @map("exams_accepted")
  accreditation      String?
  brochureUrl        String?  @db.Text @map("brochure_url")
  specialization     String?
  programMode        String?  @map("program_mode")
  courseType         String?  @map("course_type")
  isFeatured         Boolean? @default(false) @map("is_featured")
  isPopular          Boolean? @default(false) @map("is_popular")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([name])
  @@index([city])
  @@index([code])
  @@map("colleges")
}

model Course {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  duration    String
  eligibility String?
  isTrending  Boolean? @default(false) @map("is_trending")
  isActive    Boolean? @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("courses")
}

model Exam {
  id                   String    @id @default(uuid())
  name                 String
  code                 String    @unique
  category             String?
  examLevel            String?   @default("National") @map("exam_level")
  description          String?   @db.Text
  applicationStartDate DateTime? @map("application_start_date")
  applicationEndDate   DateTime? @map("application_end_date")
  examDate             DateTime? @map("exam_date")
  resultDate           DateTime? @map("result_date")
  officialWebsite      String?   @db.Text @map("official_website")
  isTrending           Boolean?  @default(false) @map("is_trending")
  isActive             Boolean?  @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([name])
  @@index([code])
  @@index([category])
  @@map("exams")
}

model Blog {
  id          String    @id @default(uuid())
  title       String
  code        String    @unique
  contentType String    @default("Article") @map("content_type")
  description String    @db.Text
  image       String?
  status      String    @default("DRAFT")
  authorId    String?   @map("author_id")
  authorName  String?   @map("author_name")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("blogs")
}

model Lead {
  id              String    @id @default(uuid())
  name            String?
  email           String?
  phone           String
  state           String?
  city            String?
  course          String?
  stream          String?
  level           String?
  college         String?
  message         String?   @db.Text
  status          String    @default("NEW")
  score           Int?      @default(50)
  counsellorId    String?   @map("counsellor_id")
  counsellorName  String?   @map("counsellor_name")
  followUpDate    DateTime? @map("follow_up_date")
  followUpNotes   String?   @db.Text @map("follow_up_notes")
  activityHistory Json?     @map("activity_history")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("leads")
}

model Placement {
  id             String   @id @default(uuid())
  collegeId      String   @map("college_id")
  year           Int
  highestPackage String?  @map("highest_package")
  averagePackage String?  @map("average_package")
  topRecruiters  Json?    @map("top_recruiters")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([collegeId])
  @@map("placements")
}

model Review {
  id              String    @id @default(uuid())
  collegeId       String    @map("college_id")
  userId          String?   @map("user_id")
  userName        String?   @map("user_name")
  rating          Float
  comment         String?   @db.Text
  status          String    @default("pending")
  rejectionReason String?   @db.Text @map("rejection_reason")
  moderatedAt     DateTime? @map("moderated_at")
  moderatedBy     String?   @map("moderated_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([collegeId])
  @@map("reviews")
}

model University {
  id              String   @id @default(uuid())
  name            String
  type            String?
  location        String?
  establishedYear Int?     @map("established_year")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([name])
  @@map("universities")
}

model Stream {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?  @db.Text
  isActive    Boolean? @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("streams")
}

model Scholarship {
  id          String   @id @default(uuid())
  collegeId   String   @map("college_id")
  name        String
  amount      String?
  eligibility String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([collegeId])
  @@map("scholarships")
}

model CollegeCourse {
  id        String  @id @default(uuid())
  collegeId String  @map("college_id")
  courseId  String  @map("course_id")
  totalFees String? @map("total_fees")
  seats     Int?
  cutoff    String?

  @@index([collegeId])
  @@index([courseId])
  @@map("college_courses")
}

model CourseExam {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  examId      String   @map("exam_id")
  isMandatory Boolean? @default(true) @map("is_mandatory")

  @@index([courseId])
  @@index([examId])
  @@map("course_exams")
}

model ExamCollege {
  id              String  @id @default(uuid())
  examId          String  @map("exam_id")
  collegeId       String  @map("college_id")
  acceptingStatus String? @default("Accepted") @map("accepting_status")

  @@index([examId])
  @@index([collegeId])
  @@map("exam_colleges")
}

model SavedCollege {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  collegeId String   @map("college_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, collegeId], map: "user_college_unique")
  @@index([userId])
  @@map("saved_colleges")
}

model State {
  id   String @id @default(uuid())
  name String @unique

  @@index([name])
  @@map("states")
}

model City {
  id      String @id @default(uuid())
  stateId String @map("state_id")
  name    String

  @@index([stateId])
  @@index([name])
  @@map("cities")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  eventType String   @map("event_type")
  metadata  Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, eventType])
  @@index([createdAt])
  @@map("activity_logs")
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  module      String
  description String?  @db.Text
  userAgent   String?  @db.Text @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
