# =========================================================
# Root .gitignore for Nursing Project (Backend & Admin Portal)
# Prevents sensitive environment variables, credentials,
# dependencies, and build artifacts from leaking to GitHub
# =========================================================

# --- 1. Environment & Secret Variables ---
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
my_api_keys.txt
*.pem
*.key
*.cert

# Safely allow example template files to be tracked
!.env.example
!*.env.example

# --- 2. Dependencies ---
node_modules/
*/node_modules/
vendor/

# --- 3. Build & Distribution Outputs ---
dist/
dist-ssr/
build/
out/
*/dist/

# --- 4. User Uploaded Files & Media ---
Backend/uploads/*
!Backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# --- 5. Logs & Debugging ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- 6. Operating System & Cache Files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.cache/
.temp/
*.tmp

# --- 7. IDEs and Code Editors ---
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
